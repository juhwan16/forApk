<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" 
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- 앱 기본 설정 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>smart_extinguisher_app</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string></string>

    <!-- iOS 14+ 네비게이션 자동 스와이프 처리 -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- 앱이 파일 다운로드 위해 필요 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- 카메라 / 사진 접근 (이미지 업로드 기능 필수) -->
    <key>NSCameraUsageDescription</key>
    <string>소화기 사진을 촬영하기 위해 카메라 접근이 필요합니다.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>소화기 사진을 선택하기 위해 사진 접근 권한이 필요합니다.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>촬영한 사진을 저장하기 위해 권한이 필요합니다.</string>

    <!-- 블루투스 권한 (필수) -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>소화기 하드웨어 기기와 블루투스로 연결하기 위해 필요합니다.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>소화기 디바이스 제어를 위해 블루투스 접근이 필요합니다.</string>

    <!-- 위치(일부 BLE 스캔은 위치 접근 필요) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>BLE 장치를 스캔하기 위해 위치 서비스가 필요합니다.</string>

    <!-- 인터넷 사용 -->
    <key>NSAllowsArbitraryLoads</key>
    <true/>

    <!-- Flutter 설정 -->
    <key>io.flutter.embedded_views_preview</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

</dict>
</plist>
